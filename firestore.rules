rules_version = '2';
// Regras de segurança do banco Zum Projetos (versão 2: equipe por colônia).
//
// Quem é quem:
// - Vanessa (UID abaixo) é a administradora: vê e muda tudo.
// - Coordenadores estão cadastrados em /pessoas/{email} com a lista das colônias
//   que acompanham. Eles só leem e editam o que é dessas colônias.
// - Ninguém além da Vanessa apaga de vez, mexe em backups, configurações ou equipe.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() { return logado() && request.auth.uid == "FoT9nkm7XlZp3g2HZAsYkXd9dR32"; }
    function meuEmail() { return request.auth.token.email.lower(); }
    function caminhoPessoa() { return /databases/$(database)/documents/pessoas/$(meuEmail()); }
    function ehPessoa() {
      return logado() && request.auth.token.email != null
        && exists(caminhoPessoa()) && get(caminhoPessoa()).data.ativo == true;
    }
    function veColonia(cid) {
      return admin() || (cid is string && ehPessoa() && cid in get(caminhoPessoa()).data.colonias);
    }

    // Pasta antiga (antes da equipe): só a Vanessa, para a migração e como cópia de segurança.
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if admin() && request.auth.uid == uid;
    }

    // Equipe: todos da equipe veem os nomes; só a Vanessa cadastra ou muda.
    match /pessoas/{email} {
      allow read: if admin() || ehPessoa() || (logado() && email == meuEmail());
      allow write: if admin();
    }

    // Projetos: a lista completa é só da Vanessa; cada coordenador abre as suas colônias.
    match /projetos/{pid} {
      allow get: if veColonia(pid);
      allow list: if admin();
      allow create, delete: if admin();
      allow update: if admin() || (veColonia(pid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(["tipo", "grupo", "excluidoEm", "arquivado", "ordem"]));
    }

    // Tarefas: pertencem a uma colônia (coloniaId). Projetos avulsos não têm colônia
    // e ficam só com a Vanessa.
    match /tarefas/{tid} {
      allow read: if admin() || veColonia(resource.data.coloniaId);
      allow create: if admin() || (veColonia(request.resource.data.coloniaId)
        && request.resource.data.projetoId == request.resource.data.coloniaId);
      allow update: if admin() || (veColonia(resource.data.coloniaId)
        && request.resource.data.coloniaId == resource.data.coloniaId
        && request.resource.data.projetoId == resource.data.projetoId);
      allow delete: if admin();

      // Comentários e histórico: qualquer um da colônia escreve em seu próprio nome;
      // ninguém além da Vanessa altera ou apaga um registro.
      match /registros/{rid} {
        function daTarefa() { return get(/databases/$(database)/documents/tarefas/$(tid)).data.coloniaId; }
        allow read: if admin() || veColonia(daTarefa());
        allow create: if (admin() || veColonia(daTarefa())) && request.resource.data.por == meuEmail();
        allow update, delete: if admin();
      }
    }

    // Configurações e cópias de segurança: só a Vanessa.
    match /config/{doc} { allow read, write: if admin(); }
    match /backups/{doc} { allow read, write: if admin(); }
  }
}
