rules_version = '2';
// Regras de segurança do banco Zum Projetos.
// Só a usuária dona do app (identificada pelo UID abaixo) pode ler e gravar,
// e apenas dentro da própria pasta. Todo o resto é bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == "yzr7gxsBnQf2bjZNGWRrBO9gzy82";
    }
  }
}
